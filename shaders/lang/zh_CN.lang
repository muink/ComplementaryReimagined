value.DETAIL_QUALITY.3=§c高

option.CLOUD_QUALITY=云层品质
option.CLOUD_QUALITY.comment=调整 “Reimagined” / “Unbound” 云层样式的照明、细节和采样质量。§e[*]§r 此设置仅适用于 “Reimagined” 或 “Unbound” 云层样式。
value.CLOUD_QUALITY.0=§aOFF
value.CLOUD_QUALITY.1=§a低
value.CLOUD_QUALITY.2=§e中
value.CLOUD_QUALITY.3=§c高

